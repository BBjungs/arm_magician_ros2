# Dobot autostart settings
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
OPENBLAS_NUM_THREADS=1
MAGICIAN_TOOL=suction_cup
DOBOT_SERIAL_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_1ccaa9c2f74aeb119ae710f21326e067-if00-port0
DOBOT_SERIAL_TIMEOUT=1.0
DOBOT_SERIAL_LOCK_PATH=/run/user/1000/dobot-magician-serial.lock
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Empty disables authentication for direct LAN access.
DOBOT_WEB_API_TOKEN=
# Canonical workspace also contains the Orbbec driver.
ORBBEC_WS=/home/bbcontact/magician_ros2
ORBBEC_CAMERA_NAME=camera
# Empty means detect the single connected Orbbec serial on every boot.
ORBBEC_SERIAL_NUMBER=
ORBBEC_DEPTH_REGISTRATION=true
# Empty disables direct V4L2 capture; frames arrive on Orbbec ROS topics.
CAMERA_DEVICE=
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30.0
STREAM_FPS=12.0
# Passive calibration does not need web video. Keep status/API available while
# avoiding an additional high-rate compressed RGB consumer.
ENABLE_CAMERA_PREVIEW=false
START_BRINGUP=true
START_CAMERA=true
START_VISION=true
START_OBJECT_FUSION=false
# Keep native publishing enabled: current driver registration needs it to
# establish the live depth-deprojection fallback contract.
ENABLE_POINT_CLOUD=true
ENABLE_CLOUD_HEALTH_VALIDATION=false
VISION_ENGINE=rgbd_shape
VISION_MODE=eye_in_hand
DOBOT_TOOL_MAPPING=canonical
# Automatically load/verify the camera-bound bundle. If it is missing or
# invalid, calibration may run only after its independent hardware safety,
# mount geometry, telemetry, alarm, depth and trajectory gates all pass.
START_CALIBRATION=true
# Set together after validating the physical bracket TF and measured mount YAML.
# Empty retains the default unverified mount; it does not certify TCP rigidity.
CALIBRATION_CARRIER_FRAME=
CALIBRATION_MOUNT_MODEL=
REQUIRE_INTEGRATED_STARTUP=true
STARTUP_AUTO=false
# Fast DDS PREALLOCATED service-reader history rejected Trigger request headers
# (24-byte request into an 11-byte history allocation). Cyclone DDS avoids that
# middleware failure for the passive calibration services.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
STARTUP_AUTO_RECALIBRATE=false
# Boot never issues HOME or observation motion on this uncommissioned cell.
STARTUP_AUTO_MOTION=false
DEVICE_WAIT_TIMEOUT_SEC=45
WEB_START_TIMEOUT_SEC=90
MONITOR_INTERVAL_SEC=1
MONITOR_FAILURE_GRACE_SEC=5
STACK_STOP_TIMEOUT_SEC=20
ROS_LOG_DIR=/tmp/dobot_ros_logs
