#!/usr/bin/env bash
# Enable the live dashboard at boot, start or restart it, and report its health.
set -euo pipefail

workspace="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
unit=dobot-eye-center-live.service
camera_unit=dobot-eye-center-camera.service
legacy=dobot-magician.service
url=http://172.30.10.101:8080
action=start
case "$#:${1:-}" in
    0:) ;;
    1:--restart) action=restart ;;
    *) echo "Usage: $0 [--restart]" >&2; exit 2 ;;
esac

[[ -x "$workspace/install/dobot_auto_center/lib/dobot_auto_center/auto_center" ]] || {
    echo "Build the development overlay in $workspace first." >&2
    exit 1
}
systemctl --user show-environment >/dev/null || {
    echo 'Cannot reach the jetson user systemd manager.' >&2
    exit 1
}
[[ -x "$workspace/scripts/start-eye-center-camera" &&
   -x "$workspace/install/orbbec_camera/lib/orbbec_camera/orbbec_camera_node" ]] || {
    echo 'The Orbbec driver is missing from the development overlay.' >&2
    exit 1
}
systemctl --user enable "$workspace/systemd/user/$unit" "$workspace/systemd/user/$camera_unit"
legacy_state="$(systemctl --user show --property=LoadState --value "$legacy")" || [[ "$legacy_state" == not-found ]]
case "$legacy_state" in
    loaded) systemctl --user disable --now "$legacy" ;;
    masked) systemctl --user stop "$legacy" ;;
    not-found) ;;
    *) echo "Unexpected $legacy load state: $legacy_state" >&2; exit 1 ;;
esac
systemctl --user daemon-reload
# A previously running installation may still be listening on 18080.
if [[ "$action" == start ]] && systemctl --user is-active --quiet "$unit" &&
    ! curl --noproxy '*' -fsS --max-time 2 "$url/health" >/dev/null 2>&1; then
    action=restart
fi
# An already running dashboard can be healthy while its camera is offline.
# Recover the managed driver on a normal invocation as well as on --restart.
if [[ "$action" == start ]] && systemctl --user is-active --quiet "$camera_unit" &&
    curl --noproxy '*' -fsS --max-time 2 "$url/health" 2>/dev/null |
        python3 -c 'import json, sys
s = json.load(sys.stdin)
sys.exit(0 if s.get("mode") in ("read-only", "hardware-home") and s.get("camera_status") == "Camera Offline" else 1)' 2>/dev/null; then
    systemctl --user restart "$camera_unit"
fi
systemctl --user "$action" "$camera_unit" "$unit"
systemctl --user is-enabled --quiet "$unit"

previous_frame=''
for ((attempt=0; attempt<30; attempt++)); do
    if systemctl --user is-active --quiet "$unit" &&
        camera="$(curl --noproxy '*' --max-time 2 -fsS "$url/health" 2>/dev/null |
            python3 -c 'import json, sys
s = json.load(sys.stdin)
if not (s["ok"] is True and s["mode"] in ("read-only", "hardware-home")
        and s["real_motion_enabled"] is (s["mode"] == "hardware-home")
        and s["stream_url"] == "/api/stream.mjpg"):
    sys.exit(1)
print(s["camera_status"])' 2>/dev/null)" &&
        frame="$(curl --noproxy '*' --max-time 2 -fsS "$url/api/status" 2>/dev/null |
            python3 -c 'import json, sys
s = json.load(sys.stdin)
if not (s["camera_source"] == "orbbec_ros" and s["camera"] is True and s["depth"] is True
        and type(s["frame_id"]) is int and s["frame_id"] > 0):
    sys.exit(1)
print(s["frame_id"])' 2>/dev/null)"; then
        if [[ -n "$previous_frame" ]] && (( frame > previous_frame )) &&
            curl --noproxy '*' --max-time 2 -fsS "$url/" 2>/dev/null |
                grep -F 'Dobot Eye-in-Hand Auto Center' >/dev/null; then
            printf 'Dashboard enabled and receiving Orbbec frames: %s/ (%s)\n' "$url" "$camera"
            exit 0
        fi
        previous_frame="$frame"
    else
        previous_frame=''
    fi
    sleep 1
done

journalctl --user -u "$camera_unit" -u "$unit" -n 30 --no-pager >&2
echo "Could not verify fresh Orbbec RGB-D frames on the dashboard at $url/." >&2
exit 1
