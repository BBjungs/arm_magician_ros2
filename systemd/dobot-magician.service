[Unit]
Description=Dobot Magician control stack, Orbbec Gemini, and web interface
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/jetson/arm_magician_ws
EnvironmentFile=/home/jetson/arm_magician_ws/config/dobot-autostart.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jetson/arm_magician_ws/scripts/start_dobot_autostart.sh
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
