<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dobot_bringup</name>
  <version>1.0.0</version>
  <description>Bringup package for Dobot Magician</description>
  <author email="kan.jan@wp.pl">Jan Kaniuka</author>
  <maintainer email="kan.jan@wp.pl">Jan Kaniuka</maintainer>
  <license>BSD</license>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>dobot_driver</exec_depend>
  <exec_depend>dobot_diagnostics</exec_depend>
  <exec_depend>dobot_end_effector</exec_depend>
  <exec_depend>dobot_homing</exec_depend>
  <exec_depend>dobot_kinematics</exec_depend>
  <exec_depend>dobot_motion</exec_depend>
  <exec_depend>dobot_state_updater</exec_depend>
  <exec_depend>dobot_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
